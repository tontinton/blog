# Cloudflare Pages response headers (Zola copies static/ verbatim into the build output).
# Voxel pieces are plain ES modules (index.html → scene.js → its modules + ../lib/*.js). Browsers may
# otherwise reuse a cached module after a deploy, so a fresh push looks unchanged until a hard refresh.
# no-cache = always revalidate (cheap 304s via ETag), so every page load picks up the latest deploy.
/voxel/*
  Cache-Control: no-cache
/v/*
  Cache-Control: no-cache
/tenochtitlan/*
  Cache-Control: no-cache
